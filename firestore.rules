rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    function isCcesAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'cces_admin';
    }

    function isCustomer() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'customer';
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'firstName', 'lastName', 'email', 'birthday', 'contactNumber',
          'address', 'role', 'customerType', 'farmNotes', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'firstName', 'lastName', 'email', 'birthday', 'contactNumber',
          'address', 'role', 'customerType', 'farmNotes', 'createdAt'
        ])
        && request.resource.data.role == 'customer'
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.email is string
        && request.resource.data.birthday is timestamp
        && request.resource.data.contactNumber is string
        && request.resource.data.address is string
        && request.resource.data.customerType == 'individual'
        && request.resource.data.farmNotes is string
        && request.resource.data.createdAt == request.time;

      allow update: if isAdmin()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
        || isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'firstName', 'lastName', 'email', 'contactNumber', 'address'
          ]);

      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /reviews/{orderId} {
        allow read: if true;

        allow create: if isCustomer()
          && !exists(/databases/$(database)/documents/products/$(productId)/reviews/$(orderId))
          && request.resource.data.keys().hasOnly([
            'orderId', 'productId', 'orderItem', 'userId', 'rating', 'comment', 'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'orderId', 'productId', 'orderItem', 'userId', 'rating', 'comment', 'createdAt'
          ])
          && request.resource.data.orderId == orderId
          && request.resource.data.productId == productId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.comment is string
          && request.resource.data.comment.size() <= 1000
          && request.resource.data.createdAt == request.time
          && request.resource.data.orderItem is map
          && request.resource.data.orderItem.productId == productId
          && exists(/databases/$(database)/documents/orders/$(orderId))
          && get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid
          && get(/databases/$(database)/documents/orders/$(orderId)).data.status == 'delivered'
          && get(/databases/$(database)/documents/orders/$(orderId)).data.get('deliveryConfirmed', false) == true
          && get(/databases/$(database)/documents/orders/$(orderId)).data.items is list
          && request.resource.data.orderItem
            in get(/databases/$(database)/documents/orders/$(orderId)).data.items;

        allow update, delete: if false;
      }
    }

    match /orders/{orderId} {
      allow get: if isAdmin() || isCcesAdmin()
        || isAuthenticated() && resource.data.userId == request.auth.uid;
      allow list: if isAdmin() || isCcesAdmin()
        || isAuthenticated() && resource.data.userId == request.auth.uid;

      // Order contents and totals must be verified by trusted server code.
      allow create: if false;

      allow update: if isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['pending', 'confirmed', 'packed', 'delivered']
        || isAuthenticated()
          && resource.data.userId == request.auth.uid
          && resource.data.status == 'delivered'
          && resource.data.get('deliveryConfirmed', false) != true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'deliveryConfirmed', 'deliveryConfirmedAt'
          ])
          && request.resource.data.deliveryConfirmed == true
          && request.resource.data.deliveryConfirmedAt == request.time;

      allow delete: if isAdmin();
    }

    match /conversations/{customerId} {
      allow get, list: if isAdmin() || isOwner(customerId);

      allow create, update: if (
          isAdmin() || isCustomer() && isOwner(customerId)
        )
        && request.resource.data.keys().hasOnly(['customerId', 'lastMessage', 'updatedAt'])
        && request.resource.data.keys().hasAll(['customerId', 'lastMessage', 'updatedAt'])
        && request.resource.data.customerId == customerId
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() > 0
        && request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow get, list: if isAdmin() || isOwner(customerId);

        allow create: if isAuthenticated()
          && request.resource.data.keys().hasOnly([
            'senderId', 'senderRole', 'text', 'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'senderId', 'senderRole', 'text', 'createdAt'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.createdAt == request.time
          && (
            isAdmin() && request.resource.data.senderRole == 'admin'
            || isCustomer() && isOwner(customerId)
              && request.resource.data.senderRole == 'customer'
          );

        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    match /settings/storefront {
      allow get: if isAdmin() || isCustomer();
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    match /storeSettings/checkout {
      allow get: if isAdmin();
      allow list: if false;
      allow create, update: if isAdmin();
      allow delete: if false;
    }
  }
}
