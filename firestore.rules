rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isFarmer() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['farmer', 'admin'];
    }

    function isLegacyFarmerAccount(userId) {
      let storefrontPath = /databases/$(database)/documents/settings/storefront;
      return exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.get('role', '') in ['farmer', 'admin']
        && exists(storefrontPath)
        && get(storefrontPath).data.get('legacyFarmerId', '') == userId;
    }

    function isActiveFarmer() {
      return isAuthenticated()
        && isFarmer()
        && (
          exists(/databases/$(database)/documents/farmerProfiles/$(request.auth.uid))
            && get(/databases/$(database)/documents/farmerProfiles/$(request.auth.uid)).data.get('status', '') == 'active'
          || !exists(/databases/$(database)/documents/farmerProfiles/$(request.auth.uid))
            && isLegacyFarmerAccount(request.auth.uid)
        );
    }

    function isCcesAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'cces_admin';
    }

    function isCustomer() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'customer';
    }

    function isLegacyFarmer() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    function isActiveFarmerId(farmerId) {
      let userPath = /databases/$(database)/documents/users/$(farmerId);
      let profilePath = /databases/$(database)/documents/farmerProfiles/$(farmerId);
      return exists(userPath)
        && get(userPath).data.get('role', '') in ['farmer', 'admin']
        && exists(profilePath)
        && get(profilePath).data.get('status', '') == 'active';
    }

    function orderPath(orderId) {
      return /databases/$(database)/documents/orders/$(orderId);
    }

    function productPath(productId) {
      return /databases/$(database)/documents/products/$(productId);
    }

    function applicationPath(userId) {
      return /databases/$(database)/documents/farmerApplications/$(userId);
    }

    function farmerProfilePath(userId) {
      return /databases/$(database)/documents/farmerProfiles/$(userId);
    }

    function validFarmerRoleChange(userId) {
      return isCcesAdmin()
        && request.auth.uid != userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
        && (
          resource.data.get('role', '') == 'customer'
            && request.resource.data.role == 'farmer'
            && existsAfter(applicationPath(userId))
            && getAfter(applicationPath(userId)).data.get('status', '') == 'approved'
            && existsAfter(farmerProfilePath(userId))
            && getAfter(farmerProfilePath(userId)).data.get('status', '') == 'active'
          || resource.data.get('role', '') == 'farmer'
            && request.resource.data.role == 'customer'
            && existsAfter(applicationPath(userId))
            && getAfter(applicationPath(userId)).data.get('status', '') == 'rejected'
            && existsAfter(farmerProfilePath(userId))
            && getAfter(farmerProfilePath(userId)).data.get('status', '') == 'suspended'
        );
    }

    function validApplicationReview(userId) {
      let application = resource.data;
      let nextApplication = request.resource.data;
      let userPath = /databases/$(database)/documents/users/$(userId);
      return isCcesAdmin()
        && nextApplication.diff(application).affectedKeys().hasOnly([
          'status', 'reviewedBy', 'reviewedAt', 'rejectionReason'
        ])
        && nextApplication.diff(application).affectedKeys().hasAll([
          'status', 'reviewedBy', 'reviewedAt'
        ])
        && nextApplication.reviewedBy == request.auth.uid
        && nextApplication.reviewedAt == request.time
        && nextApplication.rejectionReason is string
        && nextApplication.rejectionReason.size() <= 1000
        && (
          application.status == 'pending'
            && nextApplication.status == 'approved'
            && nextApplication.rejectionReason == ''
            && existsAfter(userPath)
            && getAfter(userPath).data.get('role', '') == 'farmer'
            && existsAfter(farmerProfilePath(userId))
            && getAfter(farmerProfilePath(userId)).data.get('status', '') == 'active'
          || application.status == 'pending'
            && nextApplication.status == 'rejected'
            && existsAfter(userPath)
            && getAfter(userPath).data.get('role', '') == 'customer'
          || application.status == 'approved'
            && nextApplication.status == 'rejected'
            && existsAfter(userPath)
            && getAfter(userPath).data.get('role', '') == 'customer'
            && existsAfter(farmerProfilePath(userId))
            && getAfter(farmerProfilePath(userId)).data.get('status', '') == 'suspended'
        );
    }

    function validFarmerProfileCreate(userId) {
      let applicationDoc = applicationPath(userId);
      let userPath = /databases/$(database)/documents/users/$(userId);
      return isCcesAdmin()
        && request.resource.data.keys().hasOnly([
          'status', 'farmName', 'contactNumber', 'address', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'status', 'farmName', 'contactNumber', 'address', 'createdAt'
        ])
        && request.resource.data.status == 'active'
        && existsAfter(applicationDoc)
        && getAfter(applicationDoc).data.get('status', '') == 'approved'
        && existsAfter(userPath)
        && getAfter(userPath).data.get('role', '') == 'farmer'
        && request.resource.data.farmName == getAfter(applicationDoc).data.farmName
        && request.resource.data.contactNumber == getAfter(applicationDoc).data.contactNumber
        && request.resource.data.address == getAfter(applicationDoc).data.address
        && request.resource.data.createdAt == request.time;
    }

    function validFarmerProfileOwnerCreate(userId) {
      let userPath = /databases/$(database)/documents/users/$(userId);
      let applicationDoc = applicationPath(userId);
      return isOwner(userId)
        && exists(userPath)
        && get(userPath).data.get('role', '') == 'farmer'
        && exists(applicationDoc)
        && get(applicationDoc).data.get('status', '') == 'approved'
        && request.resource.data.keys().hasOnly([
          'status', 'farmName', 'contactNumber', 'address', 'createdAt', 'storeReady',
          'deliveryFee', 'pickupLocation', 'pickupDays', 'pickupHours',
          'gcashAccountName', 'gcashAccountNumber', 'gcashQrUrl',
          'mayaAccountName', 'mayaAccountNumber', 'mayaQrUrl'
        ])
        && request.resource.data.keys().hasAll([
          'status', 'farmName', 'contactNumber', 'address', 'createdAt', 'storeReady',
          'deliveryFee', 'pickupLocation', 'pickupDays', 'pickupHours',
          'gcashAccountName', 'gcashAccountNumber', 'gcashQrUrl',
          'mayaAccountName', 'mayaAccountNumber', 'mayaQrUrl'
        ])
        && request.resource.data.status == 'active'
        && request.resource.data.storeReady is bool
        && request.resource.data.storeReady == (
          hasStorePickup(request.resource.data)
          && hasConfiguredPayment(request.resource.data)
        )
        && request.resource.data.farmName == get(applicationDoc).data.farmName
        && request.resource.data.contactNumber == get(applicationDoc).data.contactNumber
        && request.resource.data.address == get(applicationDoc).data.address
        && request.resource.data.createdAt == request.time
        && request.resource.data.deliveryFee is int
        && request.resource.data.deliveryFee >= 0
        && request.resource.data.deliveryFee <= 10000
        && request.resource.data.pickupLocation is string
        && request.resource.data.pickupDays is string
        && request.resource.data.pickupHours is string
        && request.resource.data.gcashAccountName is string
        && request.resource.data.gcashAccountNumber is string
        && request.resource.data.gcashQrUrl is string
        && request.resource.data.mayaAccountName is string
        && request.resource.data.mayaAccountNumber is string
        && request.resource.data.mayaQrUrl is string;
    }

    function validApplicationCreate(userId) {
      let userPath = /databases/$(database)/documents/users/$(userId);
      return isOwner(userId)
        && existsAfter(userPath)
        && getAfter(userPath).data.get('role', '') == 'customer'
        && !exists(applicationPath(userId))
        && request.resource.data.keys().hasOnly([
          'status', 'farmName', 'contactNumber', 'address',
          'createdAt', 'reviewedBy', 'reviewedAt', 'rejectionReason'
        ])
        && request.resource.data.keys().hasAll([
          'status', 'farmName', 'contactNumber', 'address',
          'createdAt', 'reviewedBy', 'reviewedAt', 'rejectionReason'
        ])
        && request.resource.data.status == 'pending'
        && request.resource.data.farmName is string
        && request.resource.data.farmName.size() > 0
        && request.resource.data.farmName.size() <= 200
        && request.resource.data.contactNumber is string
        && request.resource.data.contactNumber.size() > 0
        && request.resource.data.contactNumber.size() <= 40
        && request.resource.data.address is string
        && request.resource.data.address.size() > 0
        && request.resource.data.address.size() <= 1000
        && request.resource.data.createdAt == request.time
        && request.resource.data.reviewedBy == null
        && request.resource.data.reviewedAt == null
        && request.resource.data.rejectionReason == '';
    }

    function validApplicationReapply(userId) {
      return isOwner(userId)
        && isCustomer()
        && resource.data.status == 'rejected'
        && request.resource.data.keys().hasOnly([
          'status', 'farmName', 'contactNumber', 'address',
          'createdAt', 'reviewedBy', 'reviewedAt', 'rejectionReason'
        ])
        && request.resource.data.keys().hasAll([
          'status', 'farmName', 'contactNumber', 'address',
          'createdAt', 'reviewedBy', 'reviewedAt', 'rejectionReason'
        ])
        && request.resource.data.status == 'pending'
        && request.resource.data.farmName is string
        && request.resource.data.farmName.size() > 0
        && request.resource.data.farmName.size() <= 200
        && request.resource.data.contactNumber is string
        && request.resource.data.contactNumber.size() > 0
        && request.resource.data.contactNumber.size() <= 40
        && request.resource.data.address is string
        && request.resource.data.address.size() > 0
        && request.resource.data.address.size() <= 1000
        && request.resource.data.createdAt == request.time
        && request.resource.data.reviewedBy == null
        && request.resource.data.reviewedAt == null
        && request.resource.data.rejectionReason == '';
    }

    function orderContainsItem(order, productId, quantity) {
      return order.items is list
        && (
          order.items.size() > 0 && order.items[0].productId == productId && order.items[0].quantity == quantity
          || order.items.size() > 1 && order.items[1].productId == productId && order.items[1].quantity == quantity
          || order.items.size() > 2 && order.items[2].productId == productId && order.items[2].quantity == quantity
          || order.items.size() > 3 && order.items[3].productId == productId && order.items[3].quantity == quantity
          || order.items.size() > 4 && order.items[4].productId == productId && order.items[4].quantity == quantity
        );
    }

    function validCustomerInventoryUpdate(productId) {
      let orderId = request.resource.data.get('checkoutOrderId', '');
      let quantity = request.resource.data.get('checkoutQuantity', 0);
      let orderAfter = getAfter(orderPath(orderId)).data;
      let itemIndex = request.resource.data.get('checkoutItemIndex', -1);
      let item = orderAfter.items[itemIndex];
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['stock', 'sold', 'checkoutOrderId', 'checkoutQuantity', 'checkoutAction', 'checkoutItemIndex'])
        && orderId is string
        && !exists(orderPath(orderId))
        && quantity is int
        && quantity > 0
        && resource.data.stock is number
        && resource.data.stock >= quantity
        && request.resource.data.stock == resource.data.stock - quantity
        && request.resource.data.sold == resource.data.get('sold', 0) + quantity
        && request.resource.data.checkoutAction == 'sale'
        && orderAfter.userId == request.auth.uid
        && orderAfter.status == 'pending'
        && itemIndex is int
        && itemIndex >= 0
        && itemIndex < orderAfter.items.size()
        && item is map
        && item.productId == productId
        && resource.data.farmerId == orderAfter.farmerId
        && item.quantity == quantity
        && quantity <= 1000
        && item.name == resource.data.name
        && item.price == resource.data.price
        && resource.data.price is number
        && resource.data.price >= 0
        && item.unit == resource.data.get('unit', 'KG')
        && resource.data.isAvailable == true;
    }

    function validAdminInventoryRestore(productId) {
      let orderId = request.resource.data.get('checkoutOrderId', '');
      let quantity = request.resource.data.get('checkoutQuantity', 0);
      let orderBefore = get(orderPath(orderId)).data;
      let orderAfter = getAfter(orderPath(orderId)).data;
      let soldBefore = resource.data.get('sold', 0);
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['stock', 'sold', 'checkoutOrderId', 'checkoutQuantity', 'checkoutAction'])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasAll(['stock', 'sold', 'checkoutAction'])
        && orderId is string
        && quantity is int
        && quantity > 0
        && resource.data.stock is number
        && resource.data.stock >= 0
        && soldBefore is number
        && soldBefore >= 0
        && request.resource.data.stock == resource.data.stock + quantity
        && request.resource.data.sold == (soldBefore >= quantity ? soldBefore - quantity : 0)
        && request.resource.data.checkoutAction == 'refund'
        && orderBefore.userId is string
        && (
          orderBefore.status == 'pending'
            && orderBefore.paymentStatus == 'awaiting_verification'
            && orderAfter.status == 'cancelled'
            && orderAfter.paymentStatus == 'rejected'
            && orderAfter.paymentRejectedBy == request.auth.uid
            && orderAfter.paymentRejectedAt == request.time
          || orderBefore.status in ['pending', 'confirmed', 'packed']
            && orderBefore.get('paymentStatus', '') != 'awaiting_verification'
            && orderBefore.get('paymentStatus', '') != 'rejected'
            && orderAfter.status == 'cancelled'
            && orderAfter.get('paymentStatus', '') == orderBefore.get('paymentStatus', '')
        )
        && orderContainsItem(orderAfter, productId, quantity);
    }

    function validOrderItem(orderId, index) {
      let item = request.resource.data.items[index];
      let product = getAfter(productPath(item.productId)).data;
      return item is map
        && item.keys().hasOnly(['productId', 'name', 'price', 'quantity', 'unit'])
        && item.keys().size() == 5
        && item.productId is string
        && product.checkoutOrderId == orderId
        && product.checkoutItemIndex == index
        && product.checkoutAction == 'sale'
        && product.farmerId == request.resource.data.farmerId;
    }

    function orderSubtotal(items) {
      return items[0].price * items[0].quantity
        + (items.size() > 1 ? items[1].price * items[1].quantity : 0)
        + (items.size() > 2 ? items[2].price * items[2].quantity : 0)
        + (items.size() > 3 ? items[3].price * items[3].quantity : 0)
        + (items.size() > 4 ? items[4].price * items[4].quantity : 0);
    }

    function validReceiptUrl(orderId) {
      return orderId.matches('^[A-Za-z0-9_-]{1,128}$')
        && request.resource.data.paymentReceiptUrl.matches(
          '^https://res\\.cloudinary\\.com/[^/]+/image/upload/(v[0-9]+/)?payment-receipts/'
          + request.auth.uid + '/' + orderId + '/[^/?]+$'
      );
    }

    function validOrderTotals() {
      let order = request.resource.data;
      let subtotal = orderSubtotal(order.items);
      let profilePath = farmerProfilePath(order.farmerId);
      let legacySettingsPath = /databases/$(database)/documents/settings/storefront;
      let hasFarmerProfile = exists(profilePath);
      let configuredFee = hasFarmerProfile
        ? get(profilePath).data.get('deliveryFee', 100)
        : get(legacySettingsPath).data.get('deliveryFee', 100);
      let deliveryFee = order.fulfillmentType == 'delivery' && subtotal > 0 ? configuredFee : 0;
      return order.subtotal == subtotal
        && (order.fulfillmentType != 'delivery'
          || configuredFee is int && configuredFee >= 0 && configuredFee <= 10000
            && (hasFarmerProfile
              || get(legacySettingsPath).data.get('legacyFarmerId', '') == order.farmerId))
        && order.deliveryFee == deliveryFee
        && order.tax == subtotal * 0.05
        && order.total == subtotal + deliveryFee + order.tax;
    }

    function hasConfiguredPayment(settings) {
      let gcashName = settings.get('gcashAccountName', '');
      let gcashNumber = settings.get('gcashAccountNumber', '');
      let gcashQr = settings.get('gcashQrUrl', '');
      let mayaName = settings.get('mayaAccountName', '');
      let mayaNumber = settings.get('mayaAccountNumber', '');
      let mayaQr = settings.get('mayaQrUrl', '');
      return gcashName is string && gcashName.matches('.*\\S.*')
          && gcashNumber is string && gcashNumber.matches('.*\\S.*')
          && gcashQr is string && gcashQr.matches('.*\\S.*')
        || mayaName is string && mayaName.matches('.*\\S.*')
          && mayaNumber is string && mayaNumber.matches('.*\\S.*')
          && mayaQr is string && mayaQr.matches('.*\\S.*');
    }

    function hasStorePickup(settings) {
      let pickupLocation = settings.get('pickupLocation', '');
      return pickupLocation is string && pickupLocation.matches('.*\\S.*');
    }

    function storeSettingsReady(settings) {
      return settings.get('storeReady', false) == true;
    }

    function validFarmerStoreSettings(farmerId) {
      let settings = get(farmerProfilePath(farmerId)).data;
      return settings.get('status', '') == 'active'
        && storeSettingsReady(settings);
    }

    function validLegacyStorefront(farmerId) {
      let storefrontPath = /databases/$(database)/documents/settings/storefront;
      let settings = get(storefrontPath).data;
      return settings.get('legacyFarmerId', '') == farmerId
        && storeSettingsReady(settings);
    }

    function validOrderFulfillment() {
      let order = request.resource.data;
      return order.fulfillmentType == 'delivery'
          && order.deliveryAddress is string
          && order.deliveryAddress.size() > 0
          && order.pickupHours == ''
          && order.pickupDays == ''
        || order.fulfillmentType == 'pickup'
          && (
            exists(farmerProfilePath(order.farmerId))
              && get(farmerProfilePath(order.farmerId)).data.get('status', '') == 'active'
              && order.deliveryAddress == get(farmerProfilePath(order.farmerId)).data.get('pickupLocation', '')
              && order.pickupHours == get(farmerProfilePath(order.farmerId)).data.get('pickupHours', '')
              && order.pickupDays == get(farmerProfilePath(order.farmerId)).data.get('pickupDays', '')
            || !exists(farmerProfilePath(order.farmerId))
              && get(/databases/$(database)/documents/settings/storefront).data.get('legacyFarmerId', '') == order.farmerId
              && order.deliveryAddress == get(/databases/$(database)/documents/settings/storefront).data.pickupLocation
              && order.pickupHours == get(/databases/$(database)/documents/settings/storefront).data.pickupHours
              && order.pickupDays == get(/databases/$(database)/documents/settings/storefront).data.pickupDays
          );
    }

    function validOrderCreate(orderId) {
      let order = request.resource.data;
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let profilePath = farmerProfilePath(order.farmerId);
      let hasFarmerProfile = exists(profilePath);
      return isCustomer()
        && orderId.matches('^[A-Za-z0-9_-]{1,128}$')
        && order.keys().hasOnly([
          'orderNumber', 'checkoutGroupId', 'farmerId', 'userId', 'customerName', 'customerEmail', 'items',
          'subtotal', 'deliveryFee', 'tax', 'total', 'paymentMethod',
          'paymentStatus', 'status', 'fulfillmentType', 'deliveryAddress',
          'pickupHours', 'pickupDays', 'sellerNotes', 'paymentReceiptUrl', 'createdAt'
        ])
        && order.keys().hasAll([
          'orderNumber', 'checkoutGroupId', 'farmerId', 'userId', 'customerName', 'customerEmail', 'items',
          'subtotal', 'deliveryFee', 'tax', 'total', 'paymentMethod',
          'paymentStatus', 'status', 'fulfillmentType', 'deliveryAddress',
          'pickupHours', 'pickupDays', 'sellerNotes', 'paymentReceiptUrl', 'createdAt'
        ])
        && order.userId == request.auth.uid
        && order.checkoutGroupId is string
        && order.checkoutGroupId.matches('^[A-Za-z0-9_-]{1,128}$')
        && order.farmerId is string
        && exists(/databases/$(database)/documents/users/$(order.farmerId))
        && get(/databases/$(database)/documents/users/$(order.farmerId)).data.get('role', '') in ['farmer', 'admin']
        && (hasFarmerProfile
          ? validFarmerStoreSettings(order.farmerId)
          : validLegacyStorefront(order.farmerId))
        && order.customerName is string
        && order.customerEmail == profile.get('email', '')
        && order.items is list
        && order.items.size() >= 1
        && order.items.size() <= 5
        && (order.items.size() < 1 || validOrderItem(orderId, 0))
        && (order.items.size() < 2 || validOrderItem(orderId, 1))
        && (order.items.size() < 3 || validOrderItem(orderId, 2))
        && (order.items.size() < 4 || validOrderItem(orderId, 3))
        && (order.items.size() < 5 || validOrderItem(orderId, 4))
        && validOrderTotals()
        && order.paymentMethod in ['COD', 'GCASH', 'MAYA']
        && order.paymentStatus == (order.paymentMethod == 'COD' ? 'unpaid' : 'awaiting_verification')
        && order.status == 'pending'
        && validOrderFulfillment()
        && order.sellerNotes is string
        && order.sellerNotes.size() <= 1000
        && order.paymentReceiptUrl is string
        && (order.paymentMethod == 'COD'
          ? order.paymentReceiptUrl == ''
          : order.paymentReceiptUrl.size() > 0 && validReceiptUrl(orderId))
        && order.orderNumber is string
        && order.createdAt == request.time;
    }

    function validRefundProductAfter(orderId, order, index) {
      let item = order.items[index];
      let product = getAfter(productPath(item.productId)).data;
      return item is map
        && item.productId is string
        && item.quantity is int
        && product.checkoutOrderId == orderId
        && product.checkoutQuantity == item.quantity
        && product.checkoutItemIndex == index
        && product.checkoutAction == 'refund';
    }

    function validOrderRejection(orderId) {
      let order = resource.data;
      let nextOrder = request.resource.data;
      return isActiveFarmer()
        && order.get('farmerId', '') == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'paymentStatus', 'paymentRejectedAt', 'paymentRejectedBy'
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasAll([
          'status', 'paymentStatus', 'paymentRejectedAt', 'paymentRejectedBy'
        ])
        && order.status == 'pending'
        && order.paymentStatus == 'awaiting_verification'
        && order.paymentMethod in ['GCASH', 'MAYA']
        && order.paymentReceiptUrl is string
        && order.paymentReceiptUrl.size() > 0
        && nextOrder.status == 'cancelled'
        && nextOrder.paymentStatus == 'rejected'
        && nextOrder.paymentRejectedBy == request.auth.uid
        && nextOrder.paymentRejectedAt == request.time
        && order.items is list
        && order.items.size() >= 1
        && order.items.size() <= 5
        && (order.items.size() < 1 || validRefundProductAfter(orderId, order, 0))
        && (order.items.size() < 2 || validRefundProductAfter(orderId, order, 1))
        && (order.items.size() < 3 || validRefundProductAfter(orderId, order, 2))
        && (order.items.size() < 4 || validRefundProductAfter(orderId, order, 3))
        && (order.items.size() < 5 || validRefundProductAfter(orderId, order, 4));
    }

    function validOrderCancellation(orderId) {
      let order = resource.data;
      let nextOrder = request.resource.data;
      return isActiveFarmer()
        && order.get('farmerId', '') == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.diff(resource.data).affectedKeys().hasAll(['status'])
        && order.status in ['pending', 'confirmed', 'packed']
        && order.get('paymentStatus', '') != 'awaiting_verification'
        && order.get('paymentStatus', '') != 'rejected'
        && nextOrder.status == 'cancelled'
        && order.items is list
        && order.items.size() >= 1
        && order.items.size() <= 5
        && validRefundProductAfter(orderId, order, 0)
        && (order.items.size() < 2 || validRefundProductAfter(orderId, order, 1))
        && (order.items.size() < 3 || validRefundProductAfter(orderId, order, 2))
        && (order.items.size() < 4 || validRefundProductAfter(orderId, order, 3))
        && (order.items.size() < 5 || validRefundProductAfter(orderId, order, 4));
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isFarmer();
      allow list: if isFarmer();

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'firstName', 'lastName', 'email', 'birthday', 'contactNumber',
          'address', 'role', 'customerType', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'firstName', 'lastName', 'email', 'birthday', 'contactNumber',
          'address', 'role', 'customerType', 'createdAt'
        ])
        && request.resource.data.role == 'customer'
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.email is string
        && request.resource.data.birthday is timestamp
        && request.resource.data.contactNumber is string
        && request.resource.data.address is string
        && request.resource.data.customerType == 'individual'
        && request.resource.data.createdAt == request.time;

      allow update: if isFarmer()
            && resource.data.get('role', '') == 'customer'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customerType'])
            && request.resource.data.customerType in [
              'individual', 'retail', 'wholesale', 'Individual', 'Retail', 'Wholesale'
            ]
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
          || validFarmerRoleChange(userId)
        || isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'firstName', 'lastName', 'email', 'contactNumber', 'address'
          ]);

      allow delete: if isFarmer();
    }

    match /farmerApplications/{userId} {
      allow get: if isOwner(userId) || isCcesAdmin();
      allow list: if isCcesAdmin();
      allow create: if validApplicationCreate(userId);
      allow update: if validApplicationReview(userId) || validApplicationReapply(userId);
      allow delete: if false;
    }

    match /farmerProfiles/{userId} {
      allow get: if isOwner(userId) || isCcesAdmin()
        || isCustomer()
          && (
            !exists(farmerProfilePath(userId))
            || resource.data.get('status', '') == 'active'
          );
      allow list: if isCcesAdmin()
        || isCustomer()
          && resource.data.get('status', '') == 'active';
      allow create: if validFarmerProfileCreate(userId) || validFarmerProfileOwnerCreate(userId);
      allow update: if isCcesAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.diff(resource.data).affectedKeys().hasAll(['status'])
        && resource.data.get('status', '') in ['active', 'suspended']
        && request.resource.data.status in ['active', 'suspended']
        && get(/databases/$(database)/documents/users/$(userId)).data.get('role', '') == 'farmer'
        || isOwner(userId)
          && isActiveFarmer()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'storeReady', 'deliveryFee', 'pickupLocation', 'pickupDays', 'pickupHours',
            'gcashAccountName', 'gcashAccountNumber', 'gcashQrUrl',
            'mayaAccountName', 'mayaAccountNumber', 'mayaQrUrl'
          ])
          && request.resource.data.storeReady is bool
          && request.resource.data.storeReady == (
            hasStorePickup(request.resource.data)
            && hasConfiguredPayment(request.resource.data)
          )
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['deliveryFee'])
            || request.resource.data.deliveryFee is int
              && request.resource.data.deliveryFee >= 0
              && request.resource.data.deliveryFee <= 10000)
          && request.resource.data.pickupLocation is string
          && request.resource.data.pickupDays is string
          && request.resource.data.pickupHours is string
          && request.resource.data.gcashAccountName is string
          && request.resource.data.gcashAccountNumber is string
          && request.resource.data.gcashQrUrl is string
          && request.resource.data.mayaAccountName is string
          && request.resource.data.mayaAccountNumber is string
          && request.resource.data.mayaQrUrl is string;
      allow delete: if false;

      match /customerNotes/{customerId} {
        function validCustomerNote(data) {
          return data.keys().hasOnly(['notes', 'updatedBy', 'updatedAt'])
            && data.keys().hasAll(['notes', 'updatedBy', 'updatedAt'])
            && data.notes is string
            && data.notes.size() <= 4000
            && data.updatedBy == request.auth.uid
            && data.updatedAt == request.time
            && exists(/databases/$(database)/documents/users/$(customerId))
            && get(/databases/$(database)/documents/users/$(customerId)).data.get('role', '') == 'customer';
        }

        allow get, list: if isOwner(userId) && isActiveFarmer();
        allow create, update: if isOwner(userId)
          && isActiveFarmer()
          && validCustomerNote(request.resource.data);
        allow delete: if isOwner(userId) && isActiveFarmer();
      }
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isActiveFarmer()
        && request.resource.data.farmerId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'name', 'category', 'price', 'stock', 'unit', 'imageUrl', 'isAvailable',
          'sold', 'farmerId', 'createdAt', 'checkoutOrderId', 'checkoutQuantity',
          'checkoutAction', 'checkoutItemIndex'
        ])
        && request.resource.data.keys().hasAll(['name', 'category', 'price', 'stock', 'unit', 'imageUrl', 'isAvailable', 'sold', 'farmerId'])
        && request.resource.data.name is string
        && request.resource.data.category is string
        && request.resource.data.price is number
        && request.resource.data.stock is int
        && request.resource.data.unit is string
        && request.resource.data.imageUrl is string
        && request.resource.data.isAvailable is bool
        && request.resource.data.sold is int
        && request.resource.data.createdAt == request.time;
      allow delete: if isActiveFarmer() && resource.data.farmerId == request.auth.uid;
      allow update: if isCustomer() && validCustomerInventoryUpdate(productId)
        || isActiveFarmer()
          && resource.data.farmerId == request.auth.uid
          && request.resource.data.farmerId == resource.data.farmerId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['farmerId'])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['checkoutAction'])
            || validAdminInventoryRestore(productId)
          );

      match /reviews/{orderId} {
        allow read: if true;

        allow create: if isCustomer()
          && !exists(/databases/$(database)/documents/products/$(productId)/reviews/$(orderId))
          && request.resource.data.keys().hasOnly([
            'orderId', 'productId', 'orderItem', 'userId', 'rating', 'comment', 'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'orderId', 'productId', 'orderItem', 'userId', 'rating', 'comment', 'createdAt'
          ])
          && request.resource.data.orderId == orderId
          && request.resource.data.productId == productId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.comment is string
          && request.resource.data.comment.size() <= 1000
          && request.resource.data.createdAt == request.time
          && request.resource.data.orderItem is map
          && request.resource.data.orderItem.productId == productId
          && exists(/databases/$(database)/documents/orders/$(orderId))
          && get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid
          && get(/databases/$(database)/documents/orders/$(orderId)).data.status == 'delivered'
          && get(/databases/$(database)/documents/orders/$(orderId)).data.get('deliveryConfirmed', false) == true
          && get(/databases/$(database)/documents/orders/$(orderId)).data.items is list
          && request.resource.data.orderItem
            in get(/databases/$(database)/documents/orders/$(orderId)).data.items;

        allow update, delete: if false;
      }
    }

    match /orders/{orderId} {
      allow get: if isCcesAdmin()
        || isAuthenticated() && resource.data.userId == request.auth.uid
        || isActiveFarmer() && resource.data.farmerId == request.auth.uid;
      allow list: if isCcesAdmin()
        || isAuthenticated() && resource.data.userId == request.auth.uid
        || isActiveFarmer() && resource.data.farmerId == request.auth.uid;

      allow create: if validOrderCreate(orderId);

      allow update: if isActiveFarmer()
          && resource.data.farmerId == request.auth.uid
          && resource.data.status in ['pending', 'confirmed', 'packed', 'delivered']
          && resource.data.get('paymentStatus', '') != 'rejected'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['pending', 'confirmed', 'packed', 'delivered']
          && (
            resource.data.get('paymentMethod', 'COD') in ['COD', 'CASH']
            || resource.data.get('paymentStatus', '') == 'paid'
          )
        || isActiveFarmer()
          && resource.data.farmerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'paymentStatus', 'paymentVerifiedAt', 'paymentVerifiedBy'
          ])
          && request.resource.data.diff(resource.data).affectedKeys().hasAll([
            'paymentStatus', 'paymentVerifiedAt', 'paymentVerifiedBy'
          ])
          && resource.data.status == 'pending'
          && resource.data.paymentStatus == 'awaiting_verification'
          && resource.data.paymentMethod in ['GCASH', 'MAYA']
          && resource.data.paymentReceiptUrl is string
          && resource.data.paymentReceiptUrl.size() > 0
          && request.resource.data.paymentStatus == 'paid'
          && request.resource.data.paymentVerifiedAt == request.time
          && request.resource.data.paymentVerifiedBy == request.auth.uid
        || isActiveFarmer()
          && resource.data.farmerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'paymentStatus', 'paymentVerifiedAt', 'paymentVerifiedBy'
          ])
          && request.resource.data.diff(resource.data).affectedKeys().hasAll([
            'paymentStatus', 'paymentVerifiedAt', 'paymentVerifiedBy'
          ])
          && resource.data.paymentMethod == 'COD'
          && resource.data.paymentStatus == 'unpaid'
          && resource.data.status in ['pending', 'confirmed', 'packed', 'delivered']
          && request.resource.data.paymentStatus == 'paid'
          && request.resource.data.paymentVerifiedAt == request.time
          && request.resource.data.paymentVerifiedBy == request.auth.uid
        || validOrderRejection(orderId)
        || validOrderCancellation(orderId)
        || isAuthenticated()
          && resource.data.userId == request.auth.uid
          && resource.data.status == 'delivered'
          && resource.data.get('deliveryConfirmed', false) != true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'deliveryConfirmed', 'deliveryConfirmedAt'
          ])
          && request.resource.data.deliveryConfirmed == true
          && request.resource.data.deliveryConfirmedAt == request.time;

      allow delete: if isActiveFarmer() && resource.data.farmerId == request.auth.uid;
    }

    match /conversations/{customerId} {
      function validLegacyConversation(data) {
        return data.keys().hasOnly(['customerId', 'lastMessage', 'updatedAt'])
          && data.keys().hasAll(['customerId', 'lastMessage', 'updatedAt'])
          && data.customerId == customerId
          && data.lastMessage is string
          && data.lastMessage.size() > 0
          && data.updatedAt == request.time;
      }

      allow get, list: if isOwner(customerId)
        || isLegacyFarmer() && !('farmerId' in resource.data);

      allow create: if validLegacyConversation(request.resource.data)
        && (
          isOwner(customerId) && isCustomer()
          || isLegacyFarmer()
        );

      allow update: if validLegacyConversation(request.resource.data)
        && (
          isOwner(customerId) && isCustomer()
          || isLegacyFarmer() && !('farmerId' in resource.data)
        );

      allow delete: if isLegacyFarmer() && !('farmerId' in resource.data);

      match /messages/{messageId} {
        allow get, list: if isOwner(customerId) || isLegacyFarmer();

        allow create: if request.resource.data.keys().hasOnly([
            'senderId', 'senderRole', 'text', 'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'senderId', 'senderRole', 'text', 'createdAt'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.createdAt == request.time
          && (
            isCustomer() && isOwner(customerId)
              && request.resource.data.senderRole == 'customer'
            || isLegacyFarmer() && request.resource.data.senderRole == 'admin'
          );

        allow update: if false;
        allow delete: if isLegacyFarmer();
      }

      match /farmers/{farmerId} {
        function validFarmerConversation(data) {
          return data.keys().hasOnly([
              'customerId', 'farmerId', 'lastMessage', 'updatedAt'
            ])
            && data.keys().hasAll([
              'customerId', 'farmerId', 'lastMessage', 'updatedAt'
            ])
            && data.customerId == customerId
            && data.farmerId == farmerId
            && data.lastMessage is string
            && data.lastMessage.size() > 0
            && data.updatedAt == request.time;
        }

        allow get, list: if isOwner(customerId)
          || isActiveFarmer() && request.auth.uid == farmerId;

        allow create: if validFarmerConversation(request.resource.data)
          && (
            isCustomer()
              && isOwner(customerId)
              && isActiveFarmerId(farmerId)
            || isActiveFarmer()
              && request.auth.uid == farmerId
              && exists(/databases/$(database)/documents/users/$(customerId))
              && get(/databases/$(database)/documents/users/$(customerId)).data.get('role', '') == 'customer'
          );

        allow update: if validFarmerConversation(request.resource.data)
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.farmerId == resource.data.farmerId
          && (
            isCustomer() && isOwner(customerId)
            || isActiveFarmer() && request.auth.uid == farmerId
          );

        allow delete: if isActiveFarmer() && request.auth.uid == farmerId;

        match /messages/{messageId} {
          function afterFarmerConversation() {
            return getAfter(/databases/$(database)/documents/conversations/$(customerId)/farmers/$(farmerId)).data;
          }

          allow get, list: if isOwner(customerId)
            || isActiveFarmer() && request.auth.uid == farmerId;

          allow create: if request.resource.data.keys().hasOnly([
              'senderId', 'senderRole', 'text', 'createdAt'
            ])
            && request.resource.data.keys().hasAll([
              'senderId', 'senderRole', 'text', 'createdAt'
            ])
            && request.resource.data.senderId == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.createdAt == request.time
            && (
              isCustomer()
                && isOwner(customerId)
                && afterFarmerConversation().customerId == request.auth.uid
                && afterFarmerConversation().farmerId == farmerId
                && request.resource.data.senderRole == 'customer'
              || isActiveFarmer()
                && request.auth.uid == farmerId
                && afterFarmerConversation().farmerId == request.auth.uid
                && request.resource.data.senderRole in ['farmer', 'admin']
            );

          allow update: if false;
          allow delete: if isActiveFarmer() && request.auth.uid == farmerId;
        }
      }
    }

    match /settings/storefront {
      allow get: if isFarmer() || isCustomer();
      allow list: if false;
      allow create: if isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin'
        && request.resource.data.get('legacyFarmerId', '') == request.auth.uid
        && request.resource.data.storeReady is bool
        && request.resource.data.storeReady == (
          hasStorePickup(request.resource.data)
          && hasConfiguredPayment(request.resource.data)
        );
      allow update: if isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin'
        && request.resource.data.get('legacyFarmerId', '') == request.auth.uid
        && resource.data.get('legacyFarmerId', '') in ['', request.auth.uid]
        && request.resource.data.storeReady is bool
        && request.resource.data.storeReady == (
          hasStorePickup(request.resource.data)
          && hasConfiguredPayment(request.resource.data)
        );
      allow delete: if false;
    }

    match /storeSettings/checkout {
      allow get: if isFarmer();
      allow list: if false;
      allow create, update: if isFarmer();
      allow delete: if false;
    }
  }
}
