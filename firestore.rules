rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    function isCcesAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'cces_admin';
    }

    function isCustomer() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'customer';
    }

    function orderPath(orderId) {
      return /databases/$(database)/documents/orders/$(orderId);
    }

    function productPath(productId) {
      return /databases/$(database)/documents/products/$(productId);
    }

    function orderContainsItem(order, productId, quantity) {
      return order.items is list
        && (
          order.items.size() > 0 && order.items[0].productId == productId && order.items[0].quantity == quantity
          || order.items.size() > 1 && order.items[1].productId == productId && order.items[1].quantity == quantity
          || order.items.size() > 2 && order.items[2].productId == productId && order.items[2].quantity == quantity
          || order.items.size() > 3 && order.items[3].productId == productId && order.items[3].quantity == quantity
          || order.items.size() > 4 && order.items[4].productId == productId && order.items[4].quantity == quantity
        );
    }

    function validCustomerInventoryUpdate(productId) {
      let orderId = request.resource.data.get('checkoutOrderId', '');
      let quantity = request.resource.data.get('checkoutQuantity', 0);
      let orderAfter = getAfter(orderPath(orderId)).data;
      let itemIndex = request.resource.data.get('checkoutItemIndex', -1);
      let item = orderAfter.items[itemIndex];
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['stock', 'sold', 'checkoutOrderId', 'checkoutQuantity', 'checkoutAction', 'checkoutItemIndex'])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasAll(['stock', 'sold', 'checkoutOrderId', 'checkoutQuantity', 'checkoutAction', 'checkoutItemIndex'])
        && orderId is string
        && !exists(orderPath(orderId))
        && quantity is int
        && quantity > 0
        && resource.data.stock is number
        && resource.data.stock >= quantity
        && request.resource.data.stock == resource.data.stock - quantity
        && request.resource.data.sold == resource.data.get('sold', 0) + quantity
        && request.resource.data.checkoutAction == 'sale'
        && orderAfter.userId == request.auth.uid
        && orderAfter.status == 'pending'
        && itemIndex is int
        && itemIndex >= 0
        && itemIndex < orderAfter.items.size()
        && item is map
        && item.productId == productId
        && item.quantity == quantity
        && quantity <= 1000
        && item.name == resource.data.name
        && item.price == resource.data.price
        && resource.data.price is number
        && resource.data.price >= 0
        && item.unit == resource.data.get('unit', 'KG')
        && resource.data.isAvailable == true;
    }

    function validAdminInventoryRestore(productId) {
      let orderId = request.resource.data.get('checkoutOrderId', '');
      let quantity = request.resource.data.get('checkoutQuantity', 0);
      let orderBefore = get(orderPath(orderId)).data;
      let orderAfter = getAfter(orderPath(orderId)).data;
      let soldBefore = resource.data.get('sold', 0);
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['stock', 'sold', 'checkoutOrderId', 'checkoutQuantity', 'checkoutAction'])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasAll(['stock', 'sold', 'checkoutAction'])
        && orderId is string
        && quantity is int
        && quantity > 0
        && resource.data.stock is number
        && resource.data.stock >= 0
        && soldBefore is number
        && soldBefore >= 0
        && request.resource.data.stock == resource.data.stock + quantity
        && request.resource.data.sold == (soldBefore >= quantity ? soldBefore - quantity : 0)
        && request.resource.data.checkoutAction == 'refund'
        && orderBefore.userId is string
        && orderBefore.status == 'pending'
        && orderBefore.paymentStatus == 'awaiting_verification'
        && orderAfter.status == 'cancelled'
        && orderAfter.paymentStatus == 'rejected'
        && orderAfter.paymentRejectedBy == request.auth.uid
        && orderAfter.paymentRejectedAt == request.time
        && orderContainsItem(orderAfter, productId, quantity);
    }

    function validOrderItem(orderId, index) {
      let item = request.resource.data.items[index];
      let product = getAfter(productPath(item.productId)).data;
      return item is map
        && item.keys().hasOnly(['productId', 'name', 'price', 'quantity', 'unit'])
        && item.keys().size() == 5
        && item.productId is string
        && product.checkoutOrderId == orderId
        && product.checkoutItemIndex == index
        && product.checkoutAction == 'sale';
    }

    function orderSubtotal(items) {
      return items[0].price * items[0].quantity
        + (items.size() > 1 ? items[1].price * items[1].quantity : 0)
        + (items.size() > 2 ? items[2].price * items[2].quantity : 0)
        + (items.size() > 3 ? items[3].price * items[3].quantity : 0)
        + (items.size() > 4 ? items[4].price * items[4].quantity : 0);
    }

    function validReceiptUrl(orderId) {
      return orderId.matches('^[A-Za-z0-9_-]{1,128}$')
        && request.resource.data.paymentReceiptUrl.matches(
        '^https://firebasestorage\\.googleapis\\.com/v0/b/cces-farm-market\\.firebasestorage\\.app/o/payment-receipts%2F'
          + request.auth.uid + '%2F' + orderId + '%2F[^?]+\\?alt=media&token=.+$'
      );
    }

    function validOrderTotals() {
      let order = request.resource.data;
      let subtotal = orderSubtotal(order.items);
      let deliveryFee = order.fulfillmentType == 'delivery' && subtotal > 0 ? 100 : 0;
      return order.subtotal == subtotal
        && order.deliveryFee == deliveryFee
        && order.tax == subtotal * 0.05
        && order.total == subtotal + deliveryFee + order.tax;
    }

    function validOrderFulfillment() {
      let order = request.resource.data;
      return order.fulfillmentType == 'delivery'
          && order.deliveryAddress is string
          && order.deliveryAddress.size() > 0
          && order.pickupHours == ''
          && order.pickupDays == ''
        || order.fulfillmentType == 'pickup'
          && exists(/databases/$(database)/documents/settings/storefront)
          && order.deliveryAddress == get(/databases/$(database)/documents/settings/storefront).data.pickupLocation
          && order.pickupHours == get(/databases/$(database)/documents/settings/storefront).data.pickupHours
          && order.pickupDays == get(/databases/$(database)/documents/settings/storefront).data.pickupDays;
    }

    function validOrderCreate(orderId) {
      let order = request.resource.data;
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isCustomer()
        && orderId.matches('^[A-Za-z0-9_-]{1,128}$')
        && order.keys().hasOnly([
          'orderNumber', 'userId', 'customerName', 'customerEmail', 'items',
          'subtotal', 'deliveryFee', 'tax', 'total', 'paymentMethod',
          'paymentStatus', 'status', 'fulfillmentType', 'deliveryAddress',
          'pickupHours', 'pickupDays', 'sellerNotes', 'paymentReceiptUrl', 'createdAt'
        ])
        && order.keys().hasAll([
          'orderNumber', 'userId', 'customerName', 'customerEmail', 'items',
          'subtotal', 'deliveryFee', 'tax', 'total', 'paymentMethod',
          'paymentStatus', 'status', 'fulfillmentType', 'deliveryAddress',
          'pickupHours', 'pickupDays', 'sellerNotes', 'paymentReceiptUrl', 'createdAt'
        ])
        && order.userId == request.auth.uid
        && order.customerName is string
        && order.customerEmail == profile.get('email', '')
        && order.items is list
        && order.items.size() >= 1
        && order.items.size() <= 5
        && (order.items.size() < 1 || validOrderItem(orderId, 0))
        && (order.items.size() < 2 || validOrderItem(orderId, 1))
        && (order.items.size() < 3 || validOrderItem(orderId, 2))
        && (order.items.size() < 4 || validOrderItem(orderId, 3))
        && (order.items.size() < 5 || validOrderItem(orderId, 4))
        && validOrderTotals()
        && order.paymentMethod in ['COD', 'GCASH', 'MAYA']
        && order.paymentStatus == (order.paymentMethod == 'COD' ? 'unpaid' : 'awaiting_verification')
        && order.status == 'pending'
        && validOrderFulfillment()
        && order.sellerNotes is string
        && order.sellerNotes.size() <= 1000
        && order.paymentReceiptUrl is string
        && (order.paymentMethod == 'COD'
          ? order.paymentReceiptUrl == ''
          : order.paymentReceiptUrl.size() > 0 && validReceiptUrl(orderId))
        && order.orderNumber is string
        && order.createdAt == request.time;
    }

    function validRefundProductAfter(orderId, order, index) {
      let item = order.items[index];
      let product = getAfter(productPath(item.productId)).data;
      return item is map
        && item.productId is string
        && item.quantity is int
        && product.checkoutOrderId == orderId
        && product.checkoutQuantity == item.quantity
        && product.checkoutItemIndex == index
        && product.checkoutAction == 'refund';
    }

    function validOrderRejection(orderId) {
      let order = resource.data;
      let nextOrder = request.resource.data;
      return isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'paymentStatus', 'paymentRejectedAt', 'paymentRejectedBy'
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasAll([
          'status', 'paymentStatus', 'paymentRejectedAt', 'paymentRejectedBy'
        ])
        && order.status == 'pending'
        && order.paymentStatus == 'awaiting_verification'
        && order.paymentMethod in ['GCASH', 'MAYA']
        && order.paymentReceiptUrl is string
        && order.paymentReceiptUrl.size() > 0
        && nextOrder.status == 'cancelled'
        && nextOrder.paymentStatus == 'rejected'
        && nextOrder.paymentRejectedBy == request.auth.uid
        && nextOrder.paymentRejectedAt == request.time
        && order.items is list
        && order.items.size() >= 1
        && order.items.size() <= 5
        && (order.items.size() < 1 || validRefundProductAfter(orderId, order, 0))
        && (order.items.size() < 2 || validRefundProductAfter(orderId, order, 1))
        && (order.items.size() < 3 || validRefundProductAfter(orderId, order, 2))
        && (order.items.size() < 4 || validRefundProductAfter(orderId, order, 3))
        && (order.items.size() < 5 || validRefundProductAfter(orderId, order, 4));
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'firstName', 'lastName', 'email', 'birthday', 'contactNumber',
          'address', 'role', 'customerType', 'farmNotes', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'firstName', 'lastName', 'email', 'birthday', 'contactNumber',
          'address', 'role', 'customerType', 'farmNotes', 'createdAt'
        ])
        && request.resource.data.role == 'customer'
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.email is string
        && request.resource.data.birthday is timestamp
        && request.resource.data.contactNumber is string
        && request.resource.data.address is string
        && request.resource.data.customerType == 'individual'
        && request.resource.data.farmNotes is string
        && request.resource.data.createdAt == request.time;

      allow update: if isAdmin()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
        || isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'firstName', 'lastName', 'email', 'contactNumber', 'address'
          ]);

      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['checkoutAction'])
            || validAdminInventoryRestore(productId)
          )
        || isCustomer() && validCustomerInventoryUpdate(productId);

      match /reviews/{orderId} {
        allow read: if true;

        allow create: if isCustomer()
          && !exists(/databases/$(database)/documents/products/$(productId)/reviews/$(orderId))
          && request.resource.data.keys().hasOnly([
            'orderId', 'productId', 'orderItem', 'userId', 'rating', 'comment', 'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'orderId', 'productId', 'orderItem', 'userId', 'rating', 'comment', 'createdAt'
          ])
          && request.resource.data.orderId == orderId
          && request.resource.data.productId == productId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.comment is string
          && request.resource.data.comment.size() <= 1000
          && request.resource.data.createdAt == request.time
          && request.resource.data.orderItem is map
          && request.resource.data.orderItem.productId == productId
          && exists(/databases/$(database)/documents/orders/$(orderId))
          && get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid
          && get(/databases/$(database)/documents/orders/$(orderId)).data.status == 'delivered'
          && get(/databases/$(database)/documents/orders/$(orderId)).data.get('deliveryConfirmed', false) == true
          && get(/databases/$(database)/documents/orders/$(orderId)).data.items is list
          && request.resource.data.orderItem
            in get(/databases/$(database)/documents/orders/$(orderId)).data.items;

        allow update, delete: if false;
      }
    }

    match /orders/{orderId} {
      allow get: if isAdmin() || isCcesAdmin()
        || isAuthenticated() && resource.data.userId == request.auth.uid;
      allow list: if isAdmin() || isCcesAdmin()
        || isAuthenticated() && resource.data.userId == request.auth.uid;

      allow create: if validOrderCreate(orderId);

      allow update: if isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['pending', 'confirmed', 'packed', 'delivered']
          && (
            resource.data.get('paymentMethod', 'COD') in ['COD', 'CASH']
            || resource.data.get('paymentStatus', '') == 'paid'
          )
        || isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'paymentStatus', 'paymentVerifiedAt', 'paymentVerifiedBy'
          ])
          && request.resource.data.diff(resource.data).affectedKeys().hasAll([
            'paymentStatus', 'paymentVerifiedAt', 'paymentVerifiedBy'
          ])
          && resource.data.status == 'pending'
          && resource.data.paymentStatus == 'awaiting_verification'
          && resource.data.paymentMethod in ['GCASH', 'MAYA']
          && resource.data.paymentReceiptUrl is string
          && resource.data.paymentReceiptUrl.size() > 0
          && request.resource.data.paymentStatus == 'paid'
          && request.resource.data.paymentVerifiedAt == request.time
          && request.resource.data.paymentVerifiedBy == request.auth.uid
        || validOrderRejection(orderId)
        || isAuthenticated()
          && resource.data.userId == request.auth.uid
          && resource.data.status == 'delivered'
          && resource.data.get('deliveryConfirmed', false) != true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'deliveryConfirmed', 'deliveryConfirmedAt'
          ])
          && request.resource.data.deliveryConfirmed == true
          && request.resource.data.deliveryConfirmedAt == request.time;

      allow delete: if isAdmin();
    }

    match /conversations/{customerId} {
      allow get, list: if isAdmin() || isOwner(customerId);

      allow create, update: if (
          isAdmin() || isCustomer() && isOwner(customerId)
        )
        && request.resource.data.keys().hasOnly(['customerId', 'lastMessage', 'updatedAt'])
        && request.resource.data.keys().hasAll(['customerId', 'lastMessage', 'updatedAt'])
        && request.resource.data.customerId == customerId
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() > 0
        && request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow get, list: if isAdmin() || isOwner(customerId);

        allow create: if isAuthenticated()
          && request.resource.data.keys().hasOnly([
            'senderId', 'senderRole', 'text', 'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'senderId', 'senderRole', 'text', 'createdAt'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.createdAt == request.time
          && (
            isAdmin() && request.resource.data.senderRole == 'admin'
            || isCustomer() && isOwner(customerId)
              && request.resource.data.senderRole == 'customer'
          );

        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    match /settings/storefront {
      allow get: if isAdmin() || isCustomer();
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    match /storeSettings/checkout {
      allow get: if isAdmin();
      allow list: if false;
      allow create, update: if isAdmin();
      allow delete: if false;
    }
  }
}
